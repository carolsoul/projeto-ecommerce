rules_version = '2';

// Regras de segurança do Firestore para a loja.
//
// COMO APLICAR: console do Firebase -> Firestore Database -> aba "Regras",
// colar este conteúdo e publicar. (Ou `firebase deploy --only firestore:rules`,
// se um dia o Firebase CLI for configurado no projeto.)
//
// Por que isto importa: as chaves em .env.local vão para o bundle do navegador
// e são públicas por natureza. Quem de fato protege o banco são estas regras.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catálogo: vitrine pública, escrita só por admin.
    // A leitura precisa ser aberta a visitantes deslogados — a Home, a busca e
    // os cards de categoria carregam produtos antes de qualquer login.

    match /products/{sku} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dados da pessoa: perfil, carrinho e favoritos. Cada uma só enxerga os
    // próprios. O wildcard cobre as subcoleções cart e wishlist.

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Pedidos.
    //
    // A pessoa lê os próprios pedidos e NUNCA escreve nenhum. Quem cria é o
    // endpoint /api/checkout/create-order, através do Admin SDK, que ignora
    // estas regras por rodar com privilégio de administrador.
    //
    // É isso que garante que o valor cobrado foi calculado no servidor: não
    // existe caminho pelo qual o navegador consiga gravar um total.

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;

      match /tracking/{eventId} {
        allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Lista de administradores.
    //
    // A leitura do PRÓPRIO documento precisa ser permitida mesmo para quem não
    // é admin: o AuthContext consulta admins/{uid} a cada login para decidir o
    // acesso, e negar essa leitura para clientes comuns quebrava o app.
    // Ler o documento de outra pessoa continua negado, e escrever é negado
    // para todo mundo — admin se concede pelo console, nunca pela aplicação.

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
